{
  "name": "home-assist-lg",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Control a Home Assistant home from an LG webOS TV.",
  "license": "Apache-2.0",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test",
    "build": "node scripts/build.mjs",
    "check:bundle": "es-check es2016 dist/app/app.js",
    "dev": "node scripts/dev.mjs",
    "dev:home": "node scripts/fake-home-assistant.mjs",
    "package": "npm run build && npm run check:bundle && node scripts/package.mjs",
    "release": "npm run package && node scripts/release.mjs",
    "deploy": "npm run package && node scripts/deploy.mjs"
  },
  "dependencies": {
    "core-js": "^3.51.0",
    "home-assistant-js-websocket": "^9.9.0",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "@webos-tools/cli": "^3.2.6",
    "es-check": "^9.9.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1",
    "ws": "^8.23.0"
  }
}
