# Settings for `npm run deploy`, which installs the app on a rooted TV over SSH.
# Copy this file to .env.local and fill it in. .env.local is never committed.

# The TV's address on your network, for example 192.168.1.65
TV_HOST=

# Full path to the private SSH key the TV accepts for root
TV_SSH_KEY=

# These two only need setting if your TV differs from the usual rooted setup.
#TV_SSH_USER=root
#TV_SSH_PORT=22
